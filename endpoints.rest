### Get all user roles
GET {{api}}/user-roles/

###

### Get a specific user role
GET {{api}}/user-roles/admin

###

### Create a new user role
POST {{api}}/user-roles/
Content-Type: application/json

{
  "name": "admin",
  "description": "Administrator role"
}

###

### Update an existing user role (PATCH)
PATCH {{api}}/user-roles/
Content-Type: application/json

{
  "name": "moderator",
  "description": "Content moderator role changed"
}

###

### Replace an existing user role (PUT)
PUT {{api}}/user-roles/
Content-Type: application/json

{
  "id": 2,
  "name": "superadmin",
  "description": "Super administrator role"
}

###
### Delete a user role
DELETE {{api}}/user-roles/superadmin

###
### USERS ENDPOINTS ###
### Get all users (requires authentication)
GET {{api}}/users/
Authorization: Bearer {{user_token}}

### Post a new user
POST {{api}}/users/
Content-Type: application/json

{
  "name": "Jane",
  "lastname": "Smith",
  "second_lastname": "Johnson",
  "email": "jane.smith@example.com",
  "password": "securepassword123",
  "role_id": 1
}

### Get a specific user
GET {{api}}/users/jane.smith@example.com
Authorization: Bearer {{user_token}}

### Update an existing user (PATCH)
PATCH {{api}}/users/
Content-Type: application/json

{
  "id": 1,
  "name": "Janet",
  "lastname": "Smith",
  "second_lastname": "Johnson",
  "email": "jane.smith@example.com",
  "role_id": 3
}

