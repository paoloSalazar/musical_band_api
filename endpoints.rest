###
### Get all user roles
GET {{api}}/user-roles/

###

### Get a specific user role
GET {{api}}/user-roles/admin

###

### Create a new user role
POST {{api}}/user-roles/
Content-Type: application/json

{
  "name": "admin",
  "description": "Administrator role"
}

###

### Update an existing user role (PATCH)
PATCH {{api}}/user-roles/
Content-Type: application/json

{
  "name": "moderator",
  "description": "Content moderator role changed"
}

###

### Replace an existing user role (PUT)
PUT {{api}}/user-roles/
Content-Type: application/json

{
  "id": 2,
  "name": "superadmin",
  "description": "Super administrator role"
}

###
### Delete a user role
DELETE {{api}}/user-roles/superadmin

###
### PERMISSIONS ENDPOINTS ###
### Get all permissions
GET {{api}}/permissions/

###

### Get a specific permission
GET {{api}}/permissions/1

###

### Create a new permission
POST {{api}}/permissions/
Content-Type: application/json

{
  "name": "read:users",
  "description": "Permission to read users"
}

###

### Update an existing permission (PATCH)
PATCH {{api}}/permissions/1
Content-Type: application/json

{
  "name": "read:all_users",
  "description": "Permission to read all users"
}

###

### Delete a permission
DELETE {{api}}/permissions/1

###
### ROLE-PERMISSION ASSIGNMENT ENDPOINTS ###
### Get permissions for a role
GET {{api}}/permissions/1/permissions

###

### Get roles for a permission
GET {{api}}/permissions/role/1/roles

###

### Assign a permission to a role
POST {{api}}/permissions/roles/assign?permission_id=1&role_id=1

###

### Remove a permission from a role
POST {{api}}/permissions/roles/remove?permission_id=1&role_id=1

###
### USERS ENDPOINTS ###
### Get all users (requires authentication)
GET {{api}}/users/
Authorization: Bearer {{user_token}}

### Post a new user
POST {{api}}/users/
Content-Type: application/json

{
  "name": "Paolo",
  "lastname": "Salazar",
  "second_lastname": "Villarroel",
  "email": "paolo.salazar@example.com",
  "password": "salazar",
  "role_id": 1
}

### Get a specific user
GET {{api}}/users/jane.smith@example.com
Authorization: Bearer {{user_token}}

### Update an existing user (PATCH)
PATCH {{api}}/users/
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "name": "Janet",
  "lastname": "Smith",
  "second_lastname": "Johnson",
  "email": "jane.smith@example.com",
  "role_id": 3
}

###

### Update user password (PATCH)
PATCH {{api}}/users/jane.smith@example.com/password
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "current_password": "securepassword123",
  "new_password": "newsecurepassword456"
}

